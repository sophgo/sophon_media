cmake_minimum_required(VERSION 3.16)
cmake_policy(SET CMP0046 NEW)

PROJECT(bm_api_transcode)

include_directories(/opt/sophon/libsophon-current/include)
link_directories(/opt/sophon/libsophon-current/lib)

set(BMLIB    bmlib)
set(VPU_LIB  bmvd bmvenc)
set(BMCV_LIB bmcv)
set(SYSTEM_LIB dl pthread)

SET(SRCS
  test_bm_video_transcode.c
  osal.c
  queue.c
  enc_process.c
)

add_executable(test_bm_api_transcode ${SRCS})
target_compile_options(test_bm_api_transcode PRIVATE -Wno-deprecated-declarations)
target_link_libraries(test_bm_api_transcode ${BMLIB} ${VPU_LIB} ${BMCV_LIB} ${SYSTEM_LIB})
